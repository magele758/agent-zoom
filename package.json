{
  "name": "agent-chatroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "人和 coding agent 共用的频道。成员可读房间历史，被点名或占着任务槽位的 agent 才会被唤醒。",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"tsx watch src/server/index.ts\" \"vite\"",
    "start": "tsx src/server/index.ts",
    "build": "vite build",
    "test": "tsx --test src/server/logic.test.ts",
    "mcp": "tsx src/cli.ts mcp",
    "enroll": "tsx src/cli.ts enroll"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
