{
  "name": "opc-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "一人公司的业务线、研发和经营中控",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"tsx watch src/server/index.ts\" \"vite\"",
    "start": "tsx src/server/index.ts",
    "build": "vite build",
    "test": "tsx --test src/server/logic.test.ts src/*.test.ts scripts/*.test.mjs",
    "adapt": "tsx src/adapter.ts",
    "mcp": "tsx src/cli.ts mcp",
    "enroll": "tsx src/cli.ts enroll",
    "fix-owner": "tsx src/fix-owner.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test:browser": "npm run build && node scripts/browser-regression.mjs",
    "test:real:cli": "node scripts/real-cli-acceptance.mjs",
    "zoom": "node scripts/zoom.mjs",
    "zoom:local": "node scripts/zoom-local.mjs",
    "zoom:preview": "npm run build && node scripts/zoom-preview.mjs",
    "test:zoom": "npm run build && node scripts/zoom-preview.mjs --check",
    "workflow": "node scripts/workflow.mjs",
    "workflow:cleanup": "node scripts/workflow-cleanup.mjs",
    "workflow:demo": "npm run build && node scripts/workflow-smoke.mjs --interactive",
    "test:workflow": "npm run build && node scripts/workflow-smoke.mjs",
    "opc": "node scripts/zoom.mjs",
    "opc:start": "node scripts/zoom-local.mjs",
    "opc:stack": "node scripts/opc-stack.mjs",
    "opc:up": "node scripts/opc-stack.mjs up",
    "opc:verify": "node scripts/opc-stack.mjs verify",
    "opc:backup": "node scripts/opc-backup.mjs backup",
    "opc:restore": "node scripts/opc-backup.mjs restore",
    "opc:sources": "node scripts/opc-sources.mjs",
    "opc:demo": "node scripts/opc-demo.mjs",
    "test:opc": "npm run build && node scripts/opc-business-browser.mjs",
    "opc:preview": "npm run build && node scripts/opc-demo.mjs --interactive --herdr --codex"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@ppeng/agent-loop": "file:../../self-test-grounding/ppeng-agent-core/packages/agent-loop",
    "hono": "^4.13.13",
    "marked": "18.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "bin": {
    "opc-os": "scripts/zoom.mjs"
  }
}
